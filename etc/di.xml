<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Searchspring\Tracking\Service\IdProviderInterface"
                type="Searchspring\Tracking\Service\IdProvider"/>

    <type name="Searchspring\Tracking\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Searchspring\Tracking\Logger\TrackingLogger">
        <arguments>
            <argument name="name" xsi:type="string">searchspring_tracking</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Searchspring\Tracking\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
    <preference for="Searchspring\Tracking\Api\LoggerInterface"
                type="Searchspring\Tracking\Logger\TrackingLogger"/>

    <virtualType name="Searchspring\Tracking\Service\CartMetaProvider\ForViewModel"
                 type="Searchspring\Tracking\Service\CartMetaProvider">
        <arguments>
            <argument name="outputOnRoutes" xsi:type="array">
                <item name="checkout_cart" xsi:type="string">checkout_cart_index</item>
            </argument>
        </arguments>
    </virtualType>

</config>
