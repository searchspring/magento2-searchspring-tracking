<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="searchspring.tracking.product.page.global"
                   template="Searchspring_Tracking::tracking/global-script.phtml">
                <arguments>
                    <argument name="global_script_view_model" xsi:type="object">Searchspring\Tracking\ViewModel\GlobalScriptViewModel</argument>
                    <argument name="escaper_view_model" xsi:type="object">Searchspring\Tracking\ViewModel\Escaper</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template"
                   name="searchspring.tracking.product.page.shopperId"
                   template="Searchspring_Tracking::tracking/shopper-id.phtml">
                <arguments>
                    <argument name="global_script_view_model" xsi:type="object">Searchspring\Tracking\ViewModel\GlobalScriptViewModel</argument>
                    <argument name="escaper_view_model" xsi:type="object">Searchspring\Tracking\ViewModel\Escaper</argument>
                    <argument name="shopper_id_timeout" xsi:type="number">3600000</argument><!-- 1 hour in milliseconds -->
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template"
                   name="searchspring.customer.data.cart.tracker.state"
                   template="Searchspring_Tracking::tracking/mini-cart-actions-state.phtml">
                <arguments>
                    <argument name="global_script_view_model" xsi:type="object">Searchspring\Tracking\ViewModel\GlobalScriptViewModel</argument>
                    <argument name="escaper_view_model" xsi:type="object">Searchspring\Tracking\ViewModel\Escaper</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template"
                   name="searchspring.customer.data.cart.tracker.listener"
                   template="Searchspring_Tracking::tracking/mini-cart-actions-listener.phtml"
                   after="searchspring.customer.data.cart.tracker.state">
                <arguments>
                    <argument name="global_script_view_model" xsi:type="object">Searchspring\Tracking\ViewModel\GlobalScriptViewModel</argument>
                    <argument name="escaper_view_model" xsi:type="object">Searchspring\Tracking\ViewModel\Escaper</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
